{
    "name": "jerome-rdlv/cachebust-assets",
    "description": "Add cache busting fragment to assets URL, in query string or path.",
    "type": "wordpress-muplugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Jérôme Mulsant",
            "email": "jerome@rue-de-la-vieille.fr"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan": "^1.6",
        "oscarotero/env": "^2.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Rdlv\\WordPress\\CacheBustAssets\\": "src/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml",
        "phpstan": "@php vendor/bin/phpstan",
        "phpcs": "@php vendor/bin/phpcs --ignore=/vendor -p . --standard=PHPCompatibility --runtime-set testVersion 7.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        }
    }
}
